# Copy to .env (gitignored) and fill in. Nothing here is written to the output.

# Required. Sent as the User-Agent of every request to the SEC (N-PORT data
# sets, fund tickers). The SEC asks automated clients to give a name and a
# contact email, and blocks requests that do not; put your own here.
SEC_USER_AGENT=openbasket research you@example.org

# Optional. A free key from https://www.openfigi.com/api raises OpenFIGI's
# limits (names, security types and ticker-to-ISIN lookups for constituents).
# Left empty, OpenFIGI is used at its lower anonymous rate: same results,
# slower on large runs.
OPENFIGI_API_KEY=
